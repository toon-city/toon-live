# ── Base de données ────────────────────────────────────────────────────────────
DB_NAME=toonlive
DB_USER=postgres
DB_PASSWORD=postgres

# ── JWT (même secret partagé entre game-api et game-server) ───────────────────
# ⚠️  Changez cette valeur en production !
JWT_SECRET=toon-live-super-secret-jwt-key-change-in-prod!

# ── CORS (origines Angular autorisées, séparées par des virgules) ─────────────
CORS_ORIGINS=http://localhost:4200
